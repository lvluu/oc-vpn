#!/usr/bin/env bash
# oc-vpn — Run opencode through isolated WireGuard tunnels
#
# WireGuard with AllowedIPs=0.0.0.0/0 captures ALL traffic.
# This tool isolates each tunnel in a network namespace so
# multiple tunnels can coexist without route conflicts.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

# ── Source libraries ──────────────────────────────────────────
source "${SCRIPT_DIR}/lib/namespace.sh"
source "${SCRIPT_DIR}/lib/profiles.sh"
source "${SCRIPT_DIR}/lib/wireguard.sh"
source "${SCRIPT_DIR}/lib/doctor.sh"
source "${SCRIPT_DIR}/lib/tui.sh"

VERSION="0.1.0"

# ── Helpers ───────────────────────────────────────────────────
die()  { echo -e "\033[0;31merror:\033[0m $*" >&2; exit 1; }
ok()   { echo -e "\033[0;32m✓\033[0m $*"; }
info() { echo -e "\033[0;34m::\033[0m $*"; }
warn() { echo -e "\033[0;33m!\033[0m $*"; }

require_root() {
  [[ $EUID -eq 0 ]] || die "must run as root (try: sudo oc-vpn $*)"
}

require_profile() {
  profile_exists "$1" || die "profile '$1' not found. Run: oc-vpn list"
}

find_active_profile() {
  local name
  for name in $(profile_list); do
    if wg_is_up "$name"; then
      echo "$name"
      return
    fi
  done
}

# ── Cleanup ───────────────────────────────────────────────────
cleanup() {
  # Only tear down on explicit exit, not on subshell exit
  :
}
trap cleanup EXIT INT TERM

# ── Commands ──────────────────────────────────────────────────

cmd_list() {
  tui_list_profiles
}

cmd_import() {
  local name="" conf_path="" dns="" mtu=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -n|--name) name="$2"; shift 2 ;;
      --dns)     dns="$2"; shift 2 ;;
      --mtu)     mtu="$2"; shift 2 ;;
      -*)        die "unknown flag: $1" ;;
      *)         conf_path="$1"; shift ;;
    esac
  done

  [[ -z "$conf_path" ]] && die "usage: oc-vpn import <config.conf> -n <name>"
  [[ -z "$name" ]] && die "must specify --name/-n"
  [[ -f "$conf_path" ]] || die "config file not found: $conf_path"

  local args=("$conf_path" -n "$name")
  [[ -n "$dns" ]] && args+=(--dns "$dns")
  [[ -n "$mtu" ]] && args+=(--mtu "$mtu")

  profile_import "${args[@]}"
  local result=$?

  if [[ $result -eq 0 ]]; then
    ok "Profile '${name}' imported"
    echo "  Config:  $(profile_conf "$name")"
    echo "  Routes:  Table=off (host routing untouched)"
    [[ -n "$dns" ]] && echo "  DNS:     ${dns}"
    echo ""
    echo "Next:  oc-vpn up ${name}"
    echo "Run:   oc-vpn run ${name}"
  elif [[ $result -eq 2 ]]; then
    die "config file not found: ${conf_path}"
  else
    die "import failed"
  fi
}

cmd_remove() {
  local name="${1:-}"
  [[ -z "$name" ]] && die "usage: oc-vpn remove <name>"
  require_profile "$name"

  if ns_exists "$name"; then
    warn "Tearing down active namespace..."
    wg_down "$name"
  fi

  profile_remove "$name"
  ok "Profile '${name}' removed"
}

cmd_up() {
  require_root
  local name="${1:-}"

  if [[ -z "$name" ]]; then
    name=$(tui_pick_profile) || return
  fi
  require_profile "$name"

  if wg_is_up "$name"; then
    warn "Profile '${name}' is already up"
    return
  fi

  info "Bringing up ${name}..."
  wg_up "$name"
  ok "Profile '${name}' is up"
  echo "  Run:       oc-vpn run ${name}"
  echo "  IP check:  oc-vpn ip ${name}"
  echo "  Tear down: oc-vpn down ${name}"
}

cmd_down() {
  require_root
  local name="${1:-}"

  if [[ -z "$name" ]]; then
    name=$(tui_pick_profile) || return
  fi
  require_profile "$name"

  if ! ns_exists "$name"; then
    warn "Profile '${name}' is not up"
    return
  fi

  info "Tearing down ${name}..."
  wg_down "$name"
  ok "Profile '${name}' is down"
}

cmd_run() {
  require_root
  local name="${1:-}"

  if [[ -z "$name" ]]; then
    name=$(tui_pick_profile) || die "no profiles. Import one: oc-vpn import <file> -n <name>"
  fi

  require_profile "$name"

  # Tear down any other active profile first
  local active
  active=$(find_active_profile)
  if [[ -n "$active" && "$active" != "$name" ]]; then
    warn "Active profile '${active}' detected — switching to '${name}'"
    wg_down "$active"
  fi

  # Bring up if not running
  if ! wg_is_up "$name"; then
    info "Bringing up ${name}..."
    wg_up "$name"
  fi

  echo ""
  ok "Launching opencode in profile '${name}'"
  echo -e "\033[2mAll network traffic from this session goes through the WireGuard tunnel.\033[0m"
  echo -e "\033[2mPress Ctrl+C or type 'exit' to stop. Then: oc-vpn run <other-profile>\033[0m"
  echo ""

  local project_dir="$PWD"
  local run_user="${SUDO_USER:-$USER}"
  local user_home
  user_home=$(getent passwd "$run_user" | cut -d: -f6)

  # Run as real user with their full environment
  ip netns exec "$(ns_name "$name")" su - "$run_user" -c "cd '${project_dir}' && exec opencode"

  echo ""
  info "Session ended. Tunnel '${name}' still running."
  echo "  Switch:  oc-vpn run <other-profile>"
  echo "  Stop:    oc-vpn down ${name}"
}

cmd_shell() {
  require_root
  local name="${1:-}"

  if [[ -z "$name" ]]; then
    name=$(tui_pick_profile) || return
  fi
  require_profile "$name"

  if ! ns_exists "$name"; then
    die "Profile '${name}' is not up. Run: oc-vpn up ${name}"
  fi

  echo -e "\033[2mShell inside $(ns_name "$name") — all traffic routes through WireGuard.\033[0m"
  echo ""

  local run_user="${SUDO_USER:-$USER}"
  ip netns exec "$(ns_name "$name")" su - "$run_user"
}

cmd_status() {
  require_root
  tui_status
}

cmd_status_live() {
  require_root
  tui_status_live
}

cmd_doctor() {
  doctor_run
}

cmd_ip() {
  require_root
  local name="${1:-}"

  if [[ -z "$name" ]]; then
    name=$(tui_pick_profile) || return
  fi

  require_profile "$name"

  if ! wg_is_up "$name"; then
    info "Bringing up ${name}..."
    wg_up "$name"
  fi

  tui_ip_check "$name"
}

cmd_export() {
  local name="${1:-}"
  [[ -z "$name" ]] && die "usage: oc-vpn export <name>"
  require_profile "$name"

  echo -e "\033[1mProfile: ${name}\033[0m"
  echo -e "\033[2m────────────────────────────────────\033[0m"
  cat "$(profile_conf "$name")"
  echo ""
  echo -e "\033[2m────────────────────────────────────\033[0m"
  echo "File: $(profile_conf "$name")"
}

# ── Usage ─────────────────────────────────────────────────────

usage() {
  echo "oc-vpn — run opencode through isolated WireGuard tunnels"
  echo ""
  echo "USAGE"
  echo "  oc-vpn <command> [args]"
  echo ""
  echo "COMMANDS"
  echo "  list                     List all profiles and their status"
  echo "  import <file> -n <name>  Import a WireGuard config as a profile"
  echo "  remove <name>            Delete a profile"
  echo "  up <name>                Bring up a tunnel (creates namespace)"
  echo "  down <name>              Tear down a tunnel"
  echo "  run [name]               Launch opencode in a tunnel (interactive if no name)"
  echo "  shell <name>             Drop into a shell inside the namespace"
  echo "  status                   Show active tunnels and traffic"
  echo "  status --live            Live-updating dashboard"
  echo "  ip [name]                Show public IP via tunnel"
  echo "  doctor                   Check system requirements"
  echo "  export <name>            Show a profile's WireGuard config"
  echo ""
  echo "FLAGS"
  echo "  --dns <ip>       Set DNS server (comma-separated for multiple)"
  echo "  --mtu <size>     Override MTU"
  echo ""
  echo "EXAMPLES"
  echo "  oc-vpn import ./us-east.conf -n us-east"
  echo "  oc-vpn run                    # interactive profile picker"
  echo "  oc-vpn run us-east            # launch directly in us-east"
  echo "  oc-vpn ip us-east             # check public IP via tunnel"
  echo "  oc-vpn status --live          # live dashboard"
  echo "  oc-vpn down us-east           # tear down tunnel"
  echo ""
  echo "PROFILES"
  echo "  Stored in: ~/.config/oc-vpn/profiles/"
  echo ""
  echo "HOW IT WORKS"
  echo "  WireGuard with AllowedIPs=0.0.0.0/0 captures ALL traffic."
  echo "  This tool isolates each tunnel in a network namespace so"
  echo "  multiple tunnels can coexist without conflicting routes."
  echo ""
  echo "  The host's routing table is NEVER modified."
}

# ── Main ──────────────────────────────────────────────────────

main() {
  local cmd="${1:-}"
  shift 2>/dev/null || true

  case "$cmd" in
    list)                   cmd_list "$@" ;;
    import|i)               cmd_import "$@" ;;
    remove|rm)              cmd_remove "$@" ;;
    up)                     cmd_up "$@" ;;
    down)                   cmd_down "$@" ;;
    run|r)                  cmd_run "$@" ;;
    shell|sh)               cmd_shell "$@" ;;
    status|st)
      if [[ "${1:-}" == "--live" ]]; then
        cmd_status_live
      else
        cmd_status "$@"
      fi
      ;;
    ip)                     cmd_ip "$@" ;;
    doctor|doc)             cmd_doctor "$@" ;;
    export|exp)             cmd_export "$@" ;;
    -h|--help|help|"")      usage ;;
    -v|--version)           echo "oc-vpn ${VERSION}" ;;
    *)
      # If no args, launch TUI
      if [[ -z "$cmd" ]]; then
        require_root
        tui_main
      else
        die "unknown command: $cmd (try: oc-vpn --help)"
      fi
      ;;
  esac
}

main "$@"
